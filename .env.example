# Copy to .env and supply a local password before starting PostgreSQL.
POSTGRES_DB=freelanceflow
POSTGRES_USER=freelanceflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Resend delivery and webhook configuration. Never put real secrets in this file.
RESEND_API_KEY=
RESEND_SENDER="FreelanceFlow <invoices@example.com>"
RESEND_WEBHOOK_SECRET=
